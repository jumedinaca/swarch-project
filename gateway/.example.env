# Secreto HS256 compartido con el microservicio de autenticacion para
# firmar/verificar los JWT. Obligatorio, minimo 32 bytes: el gateway no
# arranca sin el. Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Valor exigido en el claim iss de los JWT. Debe coincidir con JWT_ISSUER del
# servicio de autenticacion (por defecto geopicto-auth).
JWT_ISSUER=geopicto-auth

# URLs internas de los microservicios. Usa los nombres de servicio de Docker
# Compose cuando el gateway corra en la misma red que ellos (p. ej.
# http://messages:8080); usa localhost con el puerto publicado cuando corras
# el gateway por fuera de Docker.
AUTH_SERVICE_URL=http://localhost:8101
MESSAGES_SERVICE_URL=http://localhost:8100
NETWORK_SERVICE_URL=http://localhost:8001
PROFILE_SERVICE_URL=http://localhost:8300
RATING_SERVICE_URL=http://localhost:8102
REPUTATION_SERVICE_URL=http://localhost:8600
SOCKET_GATEWAY_HTTP_URL=http://localhost:8700
SOCKET_GATEWAY_WS_URL=ws://localhost:8700

# Origenes del frontend autorizados por CORS, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082
