# Secreto HS256 compartido con el microservicio de autenticacion para
# firmar/verificar los JWT. Debe tener al menos 32 bytes.
JWT_SECRET=please-change-this-dev-only-secret-32bytes!

# URLs internas de los microservicios. Usa los nombres de servicio de Docker
# Compose cuando el gateway corra en la misma red que ellos (p. ej.
# http://messages:8080); usa localhost con el puerto publicado cuando corras
# el gateway por fuera de Docker.
AUTH_SERVICE_URL=http://localhost:8101
MESSAGES_SERVICE_URL=http://localhost:8100
