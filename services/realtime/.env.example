PORT=8080
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://geopicto:geopicto@localhost:5672/geopicto
RABBITMQ_EXCHANGE=geopicto.events
RABBITMQ_QUEUE=socket.events.q
REDIS_PUBSUB_CHANNEL=geopicto:realtime
TICKET_TTL_SECONDS=60
PRESENCE_TTL_SECONDS=60
MAX_CONNECTIONS_PER_USER=5
RATE_LIMIT_PER_SECOND=10
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=90000
MAX_FRAME_SIZE=16384
MAX_BUFFER_SIZE=100
WS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8080,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:8080
INTERNAL_TOKEN=dev-internal-token
APP_ENV=development
ALLOW_DEV_TOKEN_FALLBACK=false
