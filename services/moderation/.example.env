DATABASE_URL=postgresql://postgres:postgres@moderation-db:5432/moderation
PORT=8000

# Broker. Si se deja vacío, no se consumen mensajes; solo queda la API interna.
RABBITMQ_URL=amqp://geopicto:geopicto@rabbitmq:5672/geopicto
RABBITMQ_EXCHANGE=geopicto.events

# Protege /internal/* (mismo valor que socket-gateway).
INTERNAL_TOKEN=dev-internal-token

# Clasificador. Sin OPENAI_API_KEY se modera solo con reglas y cada decisión
# queda con degraded = true. Ojo: con la clave, el contenido de los mensajes se
# envía a OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=omni-moderation-latest
OPENAI_TIMEOUT_SECONDS=1.5

# Umbrales de la combinación híbrida (README_P2 §3).
BLOCK_THRESHOLD=0.80
WARN_THRESHOLD=0.60

# Reintentos ante errores transitorios antes de publicar moderation.failed.v1.
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=0.5
