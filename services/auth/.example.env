DATABASE_URL=postgresql://postgres:postgres@auth-db:5432/auth
PORT=8000

# Secreto para firmar los JWT (mínimo 32 caracteres). Obligatorio: el servicio no arranca sin él.
# Debe ser el mismo JWT_SECRET del API Gateway. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=geopicto-auth
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_LEEWAY_SECONDS=10

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Orígenes permitidos separados por coma (vacío si el API Gateway maneja CORS)
CORS_ORIGINS=

# Broker. Si se deja vacío, los eventos no se publican y el servicio sigue funcionando.
RABBITMQ_URL=amqp://geopicto:geopicto@rabbitmq:5672/geopicto
RABBITMQ_EXCHANGE=geopicto.events
