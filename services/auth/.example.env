DATABASE_URL=postgresql://postgres:postgres@auth-db:5432/auth
PORT=8000

# Secreto para firmar los JWT (mínimo 32 caracteres). Cámbialo en cualquier entorno compartido.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+
JWT_ALGORITHM=HS256
JWT_ISSUER=geopicto-auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_LEEWAY_SECONDS=10

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Orígenes permitidos separados por coma (vacío si el API Gateway maneja CORS)
CORS_ORIGINS=
