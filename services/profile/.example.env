DATABASE_URL=postgresql://postgres:postgres@profile-db:5432/profile
PORT=8000

# Mismo secreto y emisor que auth y el API Gateway (mínimo 32 caracteres). Obligatorio.
# El servicio vuelve a validar el JWT por su cuenta. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=geopicto-auth
JWT_LEEWAY_SECONDS=10

# Orígenes permitidos separados por coma (vacío si el API Gateway maneja CORS)
CORS_ORIGINS=

# Broker. Si se deja vacío, no se consumen eventos de auth ni se publica
# profile.updated.v1; los perfiles se crean de forma perezosa en GET /profiles/me.
RABBITMQ_URL=amqp://geopicto:geopicto@rabbitmq:5672/geopicto
RABBITMQ_EXCHANGE=geopicto.events

# Almacenamiento de avatares. Si MINIO_ENDPOINT queda vacío, las rutas de avatar responden 503.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=geopicto
MINIO_SECRET_KEY=geopicto-minio-secret
MINIO_SECURE=false
MINIO_BUCKET=geopicto-avatars

# Prefijo público de los avatares; avatarUrl = prefijo + "/" + clave del objeto.
# Detrás del gateway es http://localhost:8080/api/profiles/avatars.
AVATAR_PUBLIC_BASE_URL=http://localhost:8300/profiles/avatars

AVATAR_MAX_BYTES=5242880
AVATAR_UPLOADS_PER_HOUR=10
