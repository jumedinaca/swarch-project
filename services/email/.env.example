DATABASE_URL=postgresql://postgres:postgres@email-db:5432/email
PORT=8000

# Token interno para /internal/emails (obligatorio para invocar la API interna).
INTERNAL_TOKEN=dev-internal-token

# Broker de eventos (RabbitMQ). Si se deja vacío, los envíos de /internal/emails
# se procesan en una cola asíncrona local en memoria.
RABBITMQ_URL=amqp://geopicto:geopicto@rabbitmq:5672/geopicto
RABBITMQ_EXCHANGE=geopicto.events
PUBLISH_STATUS_EVENTS=true

# Servidor SMTP (Mailpit sin TLS en local; usar TLS/STARTTLS en producción).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM=GeoPicto <no-reply@geopicto.org>
DEFAULT_REPLY_TO=no-reply@geopicto.org

# Límites de tasa y políticas de reintentos / retención
RATE_LIMIT_PER_RECIPIENT_PER_HOUR=5
GLOBAL_RATE_LIMIT_PER_MINUTE=100
RETRY_DELAYS_SECONDS=10,60,300
RETENTION_DAYS=30
