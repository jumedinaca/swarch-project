{% extends "_base.html.j2" %}
{% block content %}
<h1 style="margin: 0 0 16px 0; font-size: 22px; line-height: 1.3; color: #111827;">
  {{ title }}
</h1>
<p style="margin: 0 0 20px 0;">
  {{ body | nl2br }}
</p>
{% if cta_url %}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 24px 0 8px 0;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #2AC769;">
      <a href="{{ cta_url }}" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 12px 24px; font-size: 15px; font-weight: 600; color: #111827; text-decoration: none; border-radius: 8px;">
        {{ cta_label }}
      </a>
    </td>
  </tr>
</table>
{% endif %}
{% endblock %}
