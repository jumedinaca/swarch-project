# --- app ---
APP_NAME=network service
PORT=8000

# --- development ---
APP_ENV=development

# --- Database ---
MONGO_HOST=localhost:27017
MONGO_DB=network_db
MONGO_ROOT_USERNAME=network_admin
MONGO_ROOT_PASSWORD=clave

# --- Security / JWT ---
# Debe coincidir con el secreto de auth y del API Gateway (mínimo 32 bytes).
JWT_SECRET=geopicto-prototipo-secreto-local-no-usar-en-produccion
JWT_ISSUER=geopicto-auth
JWT_ALGORITHM=HS256
JWT_LEEWAY_SECONDS=10

# --- RabbitMQ ---
# Dentro de Docker Compose el host es "rabbitmq"; si ejecutas el servicio fuera
# de Docker, cambia el host por localhost.
# Vacío deshabilita activity.created.v1 y el servicio sigue funcionando.
RABBITMQ_URL=amqp://geopicto:geopicto@rabbitmq:5672/geopicto
RABBITMQ_EXCHANGE=geopicto.events

# --- CORS ---
# Vacío detrás del API Gateway (el gateway agrega las cabeceras CORS)
CORS_ORIGINS=
