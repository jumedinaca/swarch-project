# --- app ---
APP_NAME=network service
PORT=8000

# --- development ---
# development: si no llega X-User-ID se usa DEV_USER_ID. Cualquier otro valor lo exige.
APP_ENV=development
DEV_USER_ID=00000000-0000-0000-0000-000000000001


# --- Database ---
MONGO_HOST=localhost:27017
MONGO_DB=network_db
MONGO_ROOT_USERNAME=network_admin
MONGO_ROOT_PASSWORD=clave

# --- CORS ---
# Vacío detrás del API Gateway (el gateway agrega las cabeceras CORS)
CORS_ORIGINS=