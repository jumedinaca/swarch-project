DATABASE_URL=postgres://postgres:postgres@messages-db:5432/messages?sslmode=disable
PORT=8080

# Debe coincidir con el secreto de auth y del API Gateway (mínimo 32 bytes).
JWT_SECRET=geopicto-prototipo-secreto-local-no-usar-en-produccion
JWT_ISSUER=geopicto-auth
JWT_LEEWAY_SECONDS=10

# Vacío deshabilita la publicación de eventos y el consumidor de moderación.
RABBITMQ_URL=amqp://geopicto:geopicto@rabbitmq:5672/geopicto
RABBITMQ_EXCHANGE=geopicto.events

# Política cuando moderation no responde o publica moderation.failed.v1.
MODERATION_TIMEOUT_SECONDS=10
PENDING_SWEEP_INTERVAL_SECONDS=5
FAIL_OPEN=true
FAIL_CLOSED=false
