# Opcional: `docker compose up` funciona sin este archivo, con los valores por
# defecto del docker-compose.yml. Copialo a .env solo si quieres cambiarlos.

# Secreto HS256 compartido entre el gateway y el servicio de autenticacion
# (el servicio firma los tokens y el gateway los verifica). Si se deja vacio se
# usa el secreto de desarrollo del docker-compose.yml. Para un secreto propio
# (minimo 32 bytes): openssl rand -base64 48
JWT_SECRET=

# Origenes del frontend autorizados por CORS en el gateway (separados por comas).
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Configuracion que se incrusta en el build web del frontend.
EXPO_PUBLIC_API_GATEWAY_URL=http://localhost:8080
# false: el frontend usa el backend real a traves del gateway.
# true: datos simulados en el navegador (para trabajar solo en la interfaz).
EXPO_PUBLIC_USE_MOCK_DATA=false
