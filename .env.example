# Copia este archivo a .env antes de ejecutar `docker compose up`.

# Secreto HS256 compartido entre el gateway y el servicio de autenticacion
# (el servicio firma los tokens y el gateway los verifica).
# Obligatorio, minimo 32 bytes. Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Origenes del frontend autorizados por CORS en el gateway (separados por comas).
CORS_ALLOWED_ORIGINS=http://localhost:8081

# 1. Agrega la IP a los orígenes CORS permitidos (separados por coma):
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://10.59.31.7:8081

# 2. Cambia localhost por la IP de tu computador:
EXPO_PUBLIC_API_GATEWAY_URL=http://10.59.31.7:8080
