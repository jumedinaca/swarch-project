# Opcional: `docker compose up` funciona sin este archivo, con los valores por
# defecto del docker-compose.yml. Copialo a .env solo si quieres cambiarlos.

# Secreto HS256 compartido entre auth (firma), gateway y los servicios que
# validan el JWT (messages, network y profile). Si se deja vacio se usa el
# secreto de desarrollo del docker-compose.yml. Para un secreto propio
# (minimo 32 bytes): openssl rand -base64 48
JWT_SECRET=

# Emisor del claim "iss". Debe ser el mismo en auth, gateway y los servicios
# que validan tokens.
JWT_ISSUER=geopicto-auth

# Origenes del navegador autorizados por CORS en el gateway (separados por
# comas). Incluye el frontend Expo (:8081) y el panel SSR (:8082).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082

# Origenes permitidos por el WebSocket de tiempo real. Normalmente coincide con
# el bloque anterior; los aliases internos ya tienen valores por defecto.
WS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8080,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:8080

# URL publica del gateway que ve el navegador. Se usa para compilar el frontend
# Expo y para construir los avatarUrl de profile. Si pruebas desde otro
# dispositivo, cambiala por la IP de tu computador, por ejemplo:
# EXPO_PUBLIC_API_GATEWAY_URL=http://10.59.31.7:8080
EXPO_PUBLIC_API_GATEWAY_URL=http://localhost:8080

# El frontend Expo usa datos simulados cuando vale true. En el sistema completo
# debe quedar en false para hablar con el backend real.
EXPO_PUBLIC_USE_MOCK_DATA=false

# Marca las cookies del panel SSR como Secure. Activalo solo si publicas
# profile-web por HTTPS.
COOKIE_SECURE=false

# Token compartido para los endpoints /internal/* de moderation, email y
# socket-gateway. Cambialo si expones esos servicios fuera de la red interna.
INTERNAL_TOKEN=dev-internal-token

# Exchange de RabbitMQ compartido por los eventos de dominio.
RABBITMQ_EXCHANGE=geopicto.events

# Opcional: clave de OpenAI para el clasificador del servicio de moderacion.
# Sin ella, moderation decide solo con reglas. Con ella, el contenido de los
# mensajes se envia a la API de moderacion de OpenAI.
OPENAI_API_KEY=

# Opcional: SMTP real. Por defecto email usa Mailpit y la bandeja queda en
# http://localhost:8025.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=tu.correo@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_USE_TLS=false
# SMTP_STARTTLS=true
# SMTP_FROM=GeoPicto <tu.correo@gmail.com>
# DEFAULT_REPLY_TO=tu.correo@gmail.com
