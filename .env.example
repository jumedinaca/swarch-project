# Opcional: `docker compose up` funciona sin este archivo, con los valores por
# defecto del docker-compose.yml. Copialo a .env solo si quieres cambiarlos.

# Secreto HS256 compartido entre auth (firma), gateway y los servicios que
# validan el JWT (messages, network y profile). Si se deja vacio se usa el
# secreto de desarrollo del docker-compose.yml. Para un secreto propio
# (minimo 32 bytes): openssl rand -base64 48
JWT_SECRET=

# Emisor del claim "iss". Debe ser el mismo en auth, gateway y los servicios
# que validan tokens.
JWT_ISSUER=geopicto-auth

# Origen publico del sistema: el reverse proxy publica por HTTPS, en un solo
# origen, la SPA Expo (/), el panel SSR (/account, /login) y el API Gateway
# (/api y WSS /api/ws). Se usa para compilar el frontend Expo (app nativa y
# desarrollo; en el navegador la app usa el origen de la pagina), construir los
# avatarUrl de profile y, por defecto, como origen permitido por CORS y por el
# WebSocket. Para probar desde otro dispositivo usa la IP de tu computador y
# genera el certificado con ella (scripts/generate-certs.sh --ip <IP>), p. ej.:
# EXPO_PUBLIC_API_GATEWAY_URL=https://10.59.31.7
EXPO_PUBLIC_API_GATEWAY_URL=https://localhost

# --- Prototype 3: interruptores de seguridad -------------------------------
# Rate Limiting / Throttling Pattern (Escenario 4). Con false el gateway no
# limita login/registro/mensajes: sirve para demostrar la vulnerabilidad.
RATE_LIMIT_ENABLED=true
# Confiar en X-Forwarded-For / X-Real-IP. Activo por defecto detras del Reverse Proxy.
RATE_LIMIT_TRUST_PROXY=true

# Token Revocation Blacklist Pattern (Escenario 5). Debe tener el mismo valor
# en auth y gateway. Con false el logout no escribe en Redis y el gateway no
# consulta la blacklist: el access token sigue valido hasta expirar.
TOKEN_BLACKLIST_ENABLED=true
# Si Redis no responde, true deja pasar el trafico (disponibilidad); false
# responde 503 (seguridad).
TOKEN_BLACKLIST_FAIL_OPEN=true
# Prefijo de las claves en Redis. Debe coincidir en auth y gateway.
TOKEN_BLACKLIST_PREFIX=auth:revoked:

# Origenes del navegador autorizados por CORS en el gateway (separados por
# comas). Solo origenes HTTPS servidos por el reverse proxy. Sin definir, el
# valor por defecto es EXPO_PUBLIC_API_GATEWAY_URL,https://localhost,https://127.0.0.1.
# CORS_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1

# Origenes permitidos en el handshake del WebSocket de tiempo real. Por defecto,
# los mismos que CORS mas los aliases internos de Compose.
# WS_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1,http://socket-gateway:8080,http://realtime:8080,http://gateway:8080

# El frontend Expo usa datos simulados cuando vale true. En el sistema completo
# debe quedar en false para hablar con el backend real.
EXPO_PUBLIC_USE_MOCK_DATA=false

# Marca las cookies del panel SSR como Secure (solo viajan por HTTPS). Dejalo
# en true: el panel solo se publica a traves del reverse proxy con TLS.
COOKIE_SECURE=true

# Token compartido para los endpoints /internal/* de moderation, email y
# socket-gateway. Cambialo si expones esos servicios fuera de la red interna.
INTERNAL_TOKEN=dev-internal-token

# Exchange de RabbitMQ compartido por los eventos de dominio.
RABBITMQ_EXCHANGE=geopicto.events

# Opcional: clave de OpenAI para el clasificador del servicio de moderacion.
# Sin ella, moderation decide solo con reglas. Con ella, el contenido de los
# mensajes se envia a la API de moderacion de OpenAI.
OPENAI_API_KEY=

# Opcional: SMTP real. Por defecto email usa Mailpit dentro de email_data_net
# (red interna, sin puerto :8025 publicado al host).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=tu.correo@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_USE_TLS=false
# SMTP_STARTTLS=true
# SMTP_FROM=GeoPicto <tu.correo@gmail.com>
# DEFAULT_REPLY_TO=tu.correo@gmail.com
