# URL interna que usa el servidor de Next.js para hablar con el API Gateway.
# En Docker Compose es http://gateway:8080; en desarrollo local http://localhost:8080.
API_GATEWAY_URL=http://localhost:8080

# Cookies de sesion Secure. En Docker Compose vale true porque el panel solo se
# publica por HTTPS a traves del reverse proxy. Sin definir, es true en
# produccion (`next start`) y false en `npm run dev` (http://localhost:3000).
COOKIE_SECURE=false
