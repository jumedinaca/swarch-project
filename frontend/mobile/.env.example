# URL publica del API Gateway detras del reverse proxy con TLS (ej. https://localhost
# o la IP de red local para celular: https://192.168.1.X). El WebSocket se deriva
# de ella (wss://). En el navegador, si la app se sirve por HTTPS, se usa siempre
# el mismo origen de la pagina.
EXPO_PUBLIC_API_GATEWAY_URL=https://localhost

# 'true' para usar simulación local (sin requerir backend encendido)
# 'false' para enviar peticiones reales al API Gateway
EXPO_PUBLIC_USE_MOCK_DATA=true
